msgid "User Service Manager"
msgstr "ユーザーサービスマネージャー"

msgid "User services"
msgstr "ユーザーサービス"

msgid "Service list"
msgstr "サービス一覧"

msgid "Managed: {count}"
msgstr "管理対象 {count}件"

msgid "Appearance: system"
msgstr "外観：システム設定に従う"

msgid "Appearance: light"
msgstr "外観：ライト"

msgid "Appearance: dark"
msgstr "外観：ダーク"

msgid "— Take your time —"
msgstr "〜ごゆっくりどうぞ〜"

msgid "Read only"
msgstr "表示のみ"

msgid "Rescan"
msgstr "再スキャン"

msgid "Checking your services…"
msgstr "サービスを確認しています…"

msgid "Services could not be loaded"
msgstr "サービスを読み込めませんでした"

msgid "No user services were found"
msgstr "ユーザーサービスは見つかりませんでした"

msgid "Manageable"
msgstr "管理可能"

msgid "Review needed"
msgstr "確認が必要"

msgid "Remove"
msgstr "登録解除"

msgid "Add"
msgstr "管理対象に追加"

msgid "Load state"
msgstr "読み込み状態"

msgid "Service file"
msgstr "サービスファイル"

msgid "Not found"
msgstr "見つかりません"

msgid "ExecStart"
msgstr "ExecStart"

msgid "Working directory"
msgstr "作業ディレクトリ"

msgid "Safety assessment"
msgstr "安全性の判定"

msgid "Search services"
msgstr "サービスを検索"

msgid "All"
msgstr "すべて"

msgid "Running"
msgstr "実行中"

msgid "Stopped"
msgstr "停止中"

msgid "Filter services"
msgstr "サービスを絞り込む"

msgid "Reload user manager"
msgstr "ユーザーマネージャーを再読み込み"

msgid "Start"
msgstr "開始"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "再起動"

msgid "Enable"
msgstr "自動起動を有効化"

msgid "Disable"
msgstr "自動起動を無効化"

msgid "Confirm service operation"
msgstr "サービス操作の確認"

msgid "The service state will be changed. Continue?"
msgstr "サービスの状態を変更します。続けますか？"

msgid "Cancel"
msgstr "キャンセル"

msgid "Continue"
msgstr "続ける"

msgid "Reload the user manager?"
msgstr "ユーザーマネージャーを再読み込みしますか？"

msgid "systemd will reread all of your user service definitions."
msgstr "systemdがユーザーサービス定義をすべて再読み込みします。"

msgid "Reload"
msgstr "再読み込み"

msgid "Operation completed"
msgstr "操作が完了しました"

msgid "User manager reloaded"
msgstr "ユーザーマネージャーを再読み込みしました"

msgid "Service logs"
msgstr "サービスログ"

msgid "Refresh logs"
msgstr "ログを更新"

msgid "Copy visible logs"
msgstr "表示中のログをコピー"

msgid "Search loaded logs"
msgstr "読み込み済みログを検索"

msgid "Load older entries"
msgstr "過去のログをさらに読み込む"

msgid "Loading logs…"
msgstr "ログを読み込んでいます…"

msgid "Logs could not be loaded"
msgstr "ログを読み込めませんでした"

msgid "No log entries"
msgstr "ログはありません"

msgid "entries shown"
msgstr "件を表示"

msgid "Visible logs copied"
msgstr "表示中のログをコピーしました"

msgid "Show logs"
msgstr "ログを表示"

msgid "Updated at {time}"
msgstr "{time} に更新"

msgid "Try again, or copy the diagnostic details."
msgstr "もう一度試すか、診断情報をコピーしてください。"

msgid "Try again"
msgstr "もう一度試す"

msgid "Copy diagnostic details"
msgstr "診断情報をコピー"

msgid "Operation failed"
msgstr "操作に失敗しました"

msgid "The requested change could not be completed."
msgstr "要求された変更を完了できませんでした。"

msgid "Close"
msgstr "閉じる"

msgid "Copy details"
msgstr "詳細をコピー"

msgid "Diagnostic details copied"
msgstr "診断情報をコピーしました"

msgid "Use Copy to copy diagnostic details"
msgstr "コピーで診断情報を取得できます"

msgid "Service inspection failed"
msgstr "サービス情報を取得できませんでした"

msgid "Copy the diagnostic details for troubleshooting."
msgstr "問題調査のため診断情報をコピーできます。"

msgid "Create a service file"
msgstr "サービスファイルを作成"

msgid "Edit service file"
msgstr "サービスファイルを編集"

msgid "Service file editor"
msgstr "サービスファイルエディター"

msgid "Validate and save"
msgstr "検証して保存"

msgid "Service name"
msgstr "サービス名"

msgid "Edit the complete systemd user service definition. Changes are checked before saving."
msgstr "systemdユーザーサービスの定義全体を編集します。変更は保存前に検証されます。"

msgid "Create a backup of the current file"
msgstr "現在のファイルのバックアップを作成"

msgid "Ready to edit"
msgstr "編集できます"

msgid "Service file could not be saved"
msgstr "サービスファイルを保存できませんでした"

msgid "create"
msgstr "新規作成"

msgid "replace"
msgstr "更新"

msgid " A timestamped backup will be created."
msgstr " タイムスタンプ付きのバックアップも作成します。"

msgid "Validation passed"
msgstr "検証に成功しました"

msgid "The app will {action} {name} and reload the user manager."
msgstr "{name} を{action}し、ユーザーマネージャーを再読み込みします。"

msgid "Save"
msgstr "保存"

msgid "Validating with systemd…"
msgstr "systemdで検証しています…"

msgid "Loading service file…"
msgstr "サービスファイルを読み込んでいます…"

msgid "Service editing is not available."
msgstr "サービス編集は利用できません。"

msgid "Saving service file…"
msgstr "サービスファイルを保存しています…"

msgid "Service file saved and user manager reloaded"
msgstr "サービスファイルを保存し、ユーザーマネージャーを再読み込みしました"

msgid "Restore latest service backup"
msgstr "最新のサービスバックアップを復元"

msgid "Manage drop-ins"
msgstr "drop-inを管理"

msgid "Back up and delete service file"
msgstr "バックアップしてサービスファイルを削除"

msgid "Drop-ins"
msgstr "drop-in"

msgid "Create drop-in"
msgstr "drop-inを作成"

msgid "Refresh"
msgstr "更新"

msgid "Drop-ins override selected directives without replacing the complete service file."
msgstr "drop-inを使うと、サービスファイル全体を置き換えずに選択した設定を上書きできます。"

msgid "Managed drop-ins"
msgstr "管理対象のdrop-in"

msgid "Loading drop-ins…"
msgstr "drop-inを読み込んでいます…"

msgid "No drop-ins were found"
msgstr "drop-inは見つかりませんでした"

msgid "Validated configuration override"
msgstr "検証対象の設定上書き"

msgid "Edit drop-in"
msgstr "drop-inを編集"

msgid "Delete drop-in"
msgstr "drop-inを削除"

msgid "Drop-ins could not be loaded"
msgstr "drop-inを読み込めませんでした"

msgid "Delete this drop-in?"
msgstr "このdrop-inを削除しますか？"

msgid "The configuration override will be removed and the user manager reloaded."
msgstr "設定の上書きを削除し、ユーザーマネージャーを再読み込みします。"

msgid "Delete"
msgstr "削除"

msgid "Drop-in editor"
msgstr "drop-inエディター"

msgid "Drop-in name"
msgstr "drop-in名"

msgid "Drop-in could not be saved"
msgstr "drop-inを保存できませんでした"

msgid "Review the effective change before saving the drop-in."
msgstr "drop-inを保存する前に実際の変更内容を確認してください。"

msgid "Drop-in management is not available."
msgstr "drop-in管理は利用できません。"

msgid "Saving drop-in…"
msgstr "drop-inを保存しています…"

msgid "Drop-in deleted and user manager reloaded"
msgstr "drop-inを削除し、ユーザーマネージャーを再読み込みしました"

msgid "Back up and delete this service file?"
msgstr "このサービスファイルをバックアップして削除しますか？"

msgid "Stop and disable the service before deleting its file"
msgstr "サービスファイルを削除する前にサービスを停止し、無効化してください"

msgid "The service and all managed drop-ins will be copied to a private backup before removal. The service must already be stopped and disabled."
msgstr "サービスと管理対象のdrop-inを非公開バックアップへコピーしてから削除します。サービスは事前に停止し、無効化してください。"

msgid "Back up and delete"
msgstr "バックアップして削除"

msgid "Service backed up, deleted, and user manager reloaded"
msgstr "サービスをバックアップして削除し、ユーザーマネージャーを再読み込みしました"

msgid "Restore the latest service backup?"
msgstr "最新のサービスバックアップを復元しますか？"

msgid "Existing service files are never overwritten during restoration."
msgstr "復元時に既存のサービスファイルを上書きすることはありません。"

msgid "Restore"
msgstr "復元"

msgid "Service restored and user manager reloaded"
msgstr "サービスを復元し、ユーザーマネージャーを再読み込みしました"

msgid "Drop-in saved and user manager reloaded"
msgstr "drop-inを保存し、ユーザーマネージャーを再読み込みしました"
